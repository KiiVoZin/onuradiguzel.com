---
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
}

const {
  title = "Onur Adıgüzel — Game Programmer",
  description = "Onur Adıgüzel (KiiVoZin) — Game Programmer based in Warsaw. Specializing in gameplay systems, shaders, and optimization across Unreal Engine 5, Unity, and Godot.",
  image,
  type,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} type={type} />

    <!-- Person schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Onur Adıgüzel",
      "alternateName": "KiiVoZin",
      "jobTitle": "Game Programmer",
      "url": "https://onuradiguzel.com/",
      "sameAs": [
        "https://github.com/KiiVoZin",
        "https://www.linkedin.com/in/onur-a-61383a20a/",
        "https://steamcommunity.com/id/KiiVoZin/"
      ]
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  </head>
  <body>
    <canvas id="particle-canvas"></canvas>
    <slot />
    <div id="cmd-bar" class="cmd-bar">
      <span class="cmd-prompt">$ </span><span id="cmd-text"></span><span class="cmd-cursor">█</span>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --green:       #3fb950;
    --green-dim:   #238636;
    --green-dark:  #0f2d0f;
    --green-faint: #091409;
    --bg:          #020302;
    --bg-card:     #070c07;
    --text:        #c9d1d9;
    --text-dim:    #8b949e;
    --border:      #1e2e1e;
    --font-pixel:  'Press Start 2P', monospace;
    --font-mono:   'Share Tech Mono', monospace;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    font-size: clamp(15px, 1.25vw, 20px);
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.7;
    min-height: 100vh;
  }

  /* ── Particle canvas ── */
  #particle-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -2;
  }

  /* CRT scanlines — behind all content, only visible on bare background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background-image: linear-gradient(
      to bottom,
      rgba(63, 185, 80, 0.10) 50%,
      transparent 50%
    );
    background-size: 100% 4px;
    mask-image: radial-gradient(
      circle 180px at var(--cx, -999px) var(--cy, -999px),
      black 0%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      circle 180px at var(--cx, -999px) var(--cy, -999px),
      black 0%,
      transparent 100%
    );
  }

  h1, h2, h3 {
    font-family: var(--font-pixel);
    color: var(--green);
    line-height: 1.5;
  }

  a {
    color: var(--green);
    text-decoration: none;
  }

  a:hover { text-decoration: underline; }

  section {
    max-width: min(1100px, 90vw);
    margin: 0 auto;
    box-sizing: border-box;
  }

  section:not(.hero) {
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: 80px 1.5rem 3.5rem;
  }

  @media (max-width: 768px) {
    section:not(.hero) {
      height: auto;
      min-height: 100vh;
      overflow: visible;
    }
  }

  /* ── Pinned sections (enabled by script on the home page) ── */
  html.pinned main {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    will-change: transform;
  }

  /* ── Command bar ── */
  .cmd-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.7rem 1.5rem;
    background: rgba(2, 3, 2, 0.97);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text);
    z-index: 500;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .cmd-bar.visible { opacity: 1; }

  .transition-flash {
    position: fixed;
    inset: 0;
    background: rgba(63, 185, 80, 0.06);
    pointer-events: none;
    z-index: 9000;
    animation: flash-in-out 0.16s ease-in-out forwards;
  }

  @keyframes flash-in-out {
    0%   { opacity: 0; }
    50%  { opacity: 1; }
    100% { opacity: 0; }
  }
  .cmd-prompt { color: var(--green); }
  .cmd-cursor {
    color: var(--green);
    animation: blink 1s step-end infinite;
    margin-left: 1px;
  }

  .section-title {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: var(--green);
    margin-bottom: 1.5rem;
  }

  .section-title::before {
    content: '> ';
    color: var(--green-dim);
  }

  .section-title::after {
    content: ' _';
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* ── Pixel sparks ── */
  .pixel-spark {
    position: fixed;
    width: var(--size, 3px);
    height: var(--size, 3px);
    background: var(--green);
    pointer-events: none;
    z-index: 10000;
    transform: translate(-50%, -50%);
    animation: spark-fly 0.5s ease-out forwards;
  }

  @keyframes spark-fly {
    0%   { transform: translate(-50%, -50%); opacity: 1; }
    100% { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))); opacity: 0; }
  }

  /* ── Chromatic aberration ── */
  h2, h3, .card-name {
    transition: text-shadow 0.3s ease-out;
  }

  h2.chroma-active, h3.chroma-active, .card-name.chroma-active {
    text-shadow: -4px 0 rgba(255, 30, 60, 0.7), 4px 0 rgba(0, 160, 255, 0.7);
    transition: none;
  }
</style>

<script>
  // ── Incoming navigation from project pages (applied once sections are laid out) ──
  const goTo = sessionStorage.getItem('goTo');
  if (goTo) sessionStorage.removeItem('goTo');

  // Particle field
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function resizeCanvas() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas, { passive: true });

  // Particles use page-space Y so they scroll with the page
  const particles = Array.from({ length: 120 }, () => ({
    x:       Math.random() * window.innerWidth,
    y:       Math.random() * window.innerHeight,
    size:    Math.random() < 0.3 ? 3 : 2,
    speed:   0.25 + Math.random() * 0.45,
    opacity: 0.12 + Math.random() * 0.22,
  }));

  function tickParticles() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.shadowBlur = 5;
    ctx.shadowColor = 'rgba(63, 185, 80, 0.9)';
    for (const p of particles) {
      ctx.fillStyle = `rgba(63, 185, 80, ${p.opacity})`;
      ctx.fillRect(Math.round(p.x), Math.round(p.y), p.size, p.size);
      p.y -= p.speed;
      if (p.y < -2) {
        p.y = canvas.height + Math.random() * 200;
        p.x = Math.random() * canvas.width;
      }
    }
    ctx.shadowBlur = 0;
    requestAnimationFrame(tickParticles);
  }
  tickParticles();

  // CRT cursor mask — tracked on body so body::before can read it
  document.addEventListener('mousemove', (e) => {
    document.body.style.setProperty('--cx', e.clientX + 'px');
    document.body.style.setProperty('--cy', e.clientY + 'px');
  });

  // Pixel sparks on click
  document.addEventListener('click', (e) => {
    const count = 12;
    for (let i = 0; i < count; i++) {
      const spark = document.createElement('div');
      spark.className = 'pixel-spark';
      spark.style.left = e.clientX + 'px';
      spark.style.top  = e.clientY + 'px';

      const angle    = (i / count) * 360 + (Math.random() * 30 - 15);
      const distance = 35 + Math.random() * 55;
      spark.style.setProperty('--dx', `${Math.cos(angle * Math.PI / 180) * distance}px`);
      spark.style.setProperty('--dy', `${Math.sin(angle * Math.PI / 180) * distance}px`);
      spark.style.setProperty('--size', `${Math.random() < 0.3 ? 2 : 3}px`);

      document.body.appendChild(spark);
      setTimeout(() => spark.remove(), 550);
    }
  });

  // Chromatic aberration — active while scrolling, fades out on stop
  const chromaEls = document.querySelectorAll<HTMLElement>('h2, h3');
  let scrollTimer: ReturnType<typeof setTimeout>;

  window.addEventListener('scroll', () => {
    chromaEls.forEach(el => el.classList.add('chroma-active'));
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(() => {
      chromaEls.forEach(el => el.classList.remove('chroma-active'));
    }, 120);
  }, { passive: true });

  // ── Section navigation ──
  const SECTIONS = [
    { el: document.querySelector<HTMLElement>('.hero'),        label: 'main'      },
    { el: document.getElementById('projects'),                 label: 'projects'  },
    { el: document.getElementById('about'),                    label: 'about'     },
    { el: document.getElementById('education'),                label: 'education' },
    { el: document.getElementById('contact'),                  label: 'contact'   },
  ].filter(s => s.el !== null) as { el: HTMLElement; label: string }[];

  const cmdBar  = document.getElementById('cmd-bar')  as HTMLElement;
  const cmdText = document.getElementById('cmd-text') as HTMLElement;

  // Pinned sections + scroll-driven command bar.
  // The scrollbar moves natively and continuously (wheel, touch, keyboard and
  // dragging the scrollbar all behave the same), but the visible page stays on
  // one section. Each gap between sections is a stretch of scroll distance in
  // which the bottom bar types the next command; when the scroll position
  // crosses into the next section, the page jumps there.
  // Sections taller than the viewport (mobile) scroll through their own
  // content first, then the typing stretch starts.
  const TYPE_DISTANCE = 0.7;  // viewport heights of scrolling per command
  const TYPE_DONE     = 0.9;  // command is fully typed at 90% of the stretch

  type Seg = { start: number; top: number; content: number; type: number };

  const mainEl = document.querySelector<HTMLElement>('main');
  const navLinks = document.querySelectorAll<HTMLElement>('.nav-links a[href^="#"]');
  let segs: Seg[] = [];
  let spacer: HTMLElement | null = null;
  let current  = -1;
  let lastText = '';
  let ticking  = false;

  function layoutSegments() {
    if (!mainEl || !spacer) return;
    const vh = window.innerHeight;
    const mainTop = mainEl.getBoundingClientRect().top;
    let acc = 0;
    segs = SECTIONS.map((s, i) => {
      const r = s.el.getBoundingClientRect();
      const seg: Seg = {
        start:   acc,
        top:     r.top - mainTop,
        content: Math.max(0, Math.round(r.height - vh)),
        type:    i < SECTIONS.length - 1 ? Math.round(vh * TYPE_DISTANCE) : 0,
      };
      acc += seg.content + seg.type;
      return seg;
    });
    spacer.style.height = `${acc + vh}px`;
  }

  function segmentAt(y: number): number {
    let i = segs.length - 1;
    while (i > 0 && y < segs[i].start) i--;
    return i;
  }

  function flash() {
    const el = document.createElement('div');
    el.className = 'transition-flash';
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 170);
  }

  function render() {
    ticking = false;
    if (!mainEl || !segs.length) return;
    const y = Math.max(0, window.scrollY);
    const i = segmentAt(y);
    const seg = segs[i];
    const o = y - seg.start;

    const shift = seg.top + Math.min(o, seg.content);
    mainEl.style.transform = `translate3d(0, ${-shift}px, 0)`;

    if (i !== current) {
      if (current !== -1) flash();
      current = i;
      const id = SECTIONS[i].el.id;
      navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === `#${id}`));
    }

    let text = `./${SECTIONS[i].label}`;
    if (seg.type > 0 && o > seg.content) {
      const p = (o - seg.content) / seg.type;
      const cmd = `./${SECTIONS[i + 1].label}`;
      text = cmd.slice(0, Math.min(cmd.length, Math.floor((p / TYPE_DONE) * (cmd.length + 1))));
    }
    if (text !== lastText) {
      cmdText.textContent = text;
      lastText = text;
    }
  }

  function requestRender() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(render);
  }

  function scrollToSection(id: string, behavior: ScrollBehavior) {
    const idx = SECTIONS.findIndex(s => s.el.id === id);
    if (idx < 0) return false;
    window.scrollTo({ top: segs[idx].start, behavior });
    return true;
  }

  if (mainEl && SECTIONS.length > 1) {
    spacer = document.createElement('div');
    spacer.id = 'scroll-spacer';
    document.body.appendChild(spacer);
    document.documentElement.classList.add('pinned');
    layoutSegments();

    const initial = goTo || location.hash.slice(1);
    if (!(initial && scrollToSection(initial, 'instant'))) render();
    cmdBar.classList.add('visible');

    window.addEventListener('scroll', requestRender, { passive: true });
    // Section sizes change when fonts/images load or the window resizes
    const remeasure = () => {
      const idx = segmentAt(window.scrollY);
      const frac = segs[idx] ? (window.scrollY - segs[idx].start) : 0;
      layoutSegments();
      window.scrollTo({ top: segs[idx].start + frac, behavior: 'instant' });
      requestRender();
    };
    window.addEventListener('resize', remeasure, { passive: true });
    new ResizeObserver(remeasure).observe(mainEl);

    // In-page links (nav ./projects etc.) scroll to that section's position,
    // so the bar types its way there.
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a) return;
      if (scrollToSection(a.getAttribute('href')!.slice(1), 'smooth')) {
        e.preventDefault();
        history.replaceState(null, '', a.getAttribute('href'));
      }
    });
  }

  // Chromatic aberration on card hover — brief flash, not persistent
  document.querySelectorAll<HTMLElement>('.card').forEach(card => {
    const title = card.querySelector<HTMLElement>('.card-name');
    if (!title) return;
    card.addEventListener('mouseenter', () => {
      title.classList.add('chroma-active');
      setTimeout(() => title.classList.remove('chroma-active'), 400);
    });
  });

</script>
